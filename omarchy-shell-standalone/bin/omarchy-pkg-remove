#!/bin/bash

# omarchy:summary=Show a picker TUI for removing installed packages.
# omarchy:requires-sudo=true

set -uo pipefail

command -v gum >/dev/null || { echo "gum is required for the package picker" >&2; exit 1; }

list_cmd="pacman -Qqe"
command -v paru >/dev/null && list_cmd="paru -Qqe"

pkg_names=$($list_cmd | gum filter --no-limit --header "Remove — type to filter, Tab to multi-select")

if [[ -n ${pkg_names:-} ]]; then
  # shellcheck disable=SC2086
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -Rns --noconfirm
  omarchy-show-done $?
fi
